# ─────────────────────────────────────────────────────────────
# Davomat Pro — Environment variables
# Copy this file to `.env` and fill in real values.
# ─────────────────────────────────────────────────────────────

# Database (PostgreSQL)
DATABASE_URL="postgresql://davomat:davomat@localhost:5432/davomat_pro?schema=public"

# JWT secret — generate with: openssl rand -base64 32
JWT_SECRET="please-change-me-to-a-long-random-string-min-32-chars"
JWT_EXPIRES_IN="7d"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# File upload limits
MAX_UPLOAD_SIZE_MB="5"

# Face recognition tuning
FACE_MATCH_THRESHOLD="0.55"
LATE_THRESHOLD_MINUTES="15"

# Demo mode — pre-fills the login form with admin/admin123 and shows demo
# credentials on the login page. NEVER enable in real production.
NEXT_PUBLIC_DEMO_CREDENTIALS="0"

# Demo seed — `npm run seed` writes fake students, schedules and history with
# guessable passwords. It refuses to run when NODE_ENV=production unless you
# set ALLOW_DEMO_SEED=1. For a real database use `npm run admin:create` instead.
ALLOW_DEMO_SEED="0"
# Optional overrides for the demo account passwords.
SEED_ADMIN_PASSWORD=""
SEED_TEACHER_PASSWORD=""
SEED_STUDENT_PASSWORD=""
SEED_PARENT_PASSWORD=""

# Login brute-force protection (per IP)
LOGIN_RATE_LIMIT="10"          # max attempts...
LOGIN_RATE_WINDOW_SEC="60"     # ...per this many seconds

# Face scan rate limit (per user) — stops a stuck/hostile client from
# hammering the 128-dim matching loop on every frame.
RECOGNIZE_RATE_LIMIT="90"      # max scans...
RECOGNIZE_RATE_WINDOW_SEC="60" # ...per this many seconds (scanner sends ~30/min)

# ── Optional integrations ────────────────────────────────────

# Telegram bot (leave empty to disable)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# SMS provider (Eskiz.uz example — leave empty to disable)
SMS_PROVIDER_EMAIL=""
SMS_PROVIDER_PASSWORD=""
SMS_FROM="4546"

# S3-compatible storage (optional — falls back to local /public/uploads)
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_REGION="us-east-1"
