// Davomat Pro — Database schema
// PostgreSQL + Prisma — Para (Period) asosida

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Users
// ─────────────────────────────────────────────────────────────
enum Role {
  ADMIN
  TEACHER
  STUDENT
  PARENT
}

model User {
  id           String   @id @default(cuid())
  fullName     String
  username     String   @unique
  email        String?  @unique
  phone        String?
  passwordHash String

  // Plain password — STORED for admin to view/give to user.
  // (Bilan birga hash ham bor, login uchun)
  // Bu maktab tizimi uchun, admin login/parolni ko'rib bera olishi kerak.
  plainPassword String?

  role         Role     @default(TEACHER)
  isActive     Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lessons          Lesson[]      @relation("TeacherLessons")
  attendanceMarked Attendance[]  @relation("MarkedBy")
  studentProfile   Student?      @relation("StudentUser")
  children         Student[]     @relation("ParentChildren")

  @@index([username])
  @@index([role])
}

// ─────────────────────────────────────────────────────────────
// Periods (Paralar) — masalan: 1-dars 08:00–08:45
// ─────────────────────────────────────────────────────────────
model Period {
  id        String @id @default(cuid())
  number    Int    @unique // 1, 2, 3, 4, 5, 6
  name      String         // "1-dars", "2-dars"
  startTime String         // "08:00"
  endTime   String         // "08:45"

  lessons Lesson[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────
// Subjects (Fanlar)
// ─────────────────────────────────────────────────────────────
model Subject {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  color       String  @default("#3b82f6")

  lessons Lesson[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────
// Lessons (Dars jadvali) — Subject + Group + Teacher + Day + Period
// ─────────────────────────────────────────────────────────────
model Lesson {
  id        String @id @default(cuid())

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  groupId String
  group   Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)

  teacherId String
  teacher   User    @relation("TeacherLessons", fields: [teacherId], references: [id], onDelete: Cascade)

  // Day of week
  dayOfWeek String // "Mon", "Tue", ...

  // Period (para) — vaqt avtomatik shu yerdan keladi
  periodId String
  period   Period   @relation(fields: [periodId], references: [id], onDelete: Restrict)

  // Attendance window — necha daqiqa kamera yoniq turadi (default 5)
  attendanceWindowMinutes Int @default(5)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendance Attendance[]

  // Bir guruhda bir kunda bir parada faqat bitta dars bo'lishi mumkin
  @@unique([groupId, dayOfWeek, periodId])
  @@index([teacherId])
  @@index([subjectId])
  @@index([dayOfWeek])
}

// ─────────────────────────────────────────────────────────────
// Groups (Sinflar)
// ─────────────────────────────────────────────────────────────
model Group {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?

  students Student[]
  lessons  Lesson[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────
// Students
// ─────────────────────────────────────────────────────────────
model Student {
  id          String  @id @default(cuid())
  fullName    String
  phone       String?
  parentPhone String?
  photoUrl    String

  faceDescriptor Json?

  groupId String?
  group   Group?  @relation(fields: [groupId], references: [id], onDelete: SetNull)

  userId String? @unique
  user   User?   @relation("StudentUser", fields: [userId], references: [id], onDelete: SetNull)

  parents User[] @relation("ParentChildren")

  attendance Attendance[]

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([groupId])
  @@index([fullName])
}

// ─────────────────────────────────────────────────────────────
// Attendance
// ─────────────────────────────────────────────────────────────
enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
}

model Attendance {
  id        String           @id @default(cuid())
  studentId String
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  // Lesson bilan bog'langan
  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  status    AttendanceStatus
  date      DateTime
  checkInAt DateTime?

  method     String  @default("face") // face / manual / auto-absent
  confidence Float?

  markedById String?
  markedBy   User?  @relation("MarkedBy", fields: [markedById], references: [id], onDelete: SetNull)

  notes String?

  createdAt DateTime @default(now())

  // Bir talaba × bir kun × bir dars = bitta yozuv
  @@unique([studentId, date, lessonId])
  @@index([date])
  @@index([studentId])
  @@index([lessonId])
  @@index([status])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────
// Audit log — kim, qachon, nima qildi (xavfsizlik izi)
// Ataylab User bilan relation yo'q: foydalanuvchi o'chirilsa ham iz qoladi.
// ─────────────────────────────────────────────────────────────
model AuditLog {
  id        String   @id @default(cuid())
  action    String   // "auth.login", "auth.login_failed", "student.create", ...
  actorId   String?
  actorName String?
  targetId  String?  // ta'sir ko'rgan obyekt IDsi (student, user, ...)
  ip        String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([action])
  @@index([actorId])
  @@index([createdAt])
}
